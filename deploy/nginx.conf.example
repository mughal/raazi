# Install as a site configuration on the host. Replace the hostname and TLS paths.
# Nginx and Docker must run on the same host for this localhost upstream.
server {
    listen 80;
    server_name raazi.example.com;
    return 301 https://raazi.example.com$request_uri;
}
server {
    listen 443 ssl;
    server_name raazi.example.com;
    ssl_certificate /etc/nginx/tls/raazi.crt;
    ssl_certificate_key /etc/nginx/tls/raazi.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 21m;
    add_header Strict-Transport-Security "max-age=31536000" always;

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Connection "";
        proxy_connect_timeout 10s;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }
}

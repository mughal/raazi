# Root Podman context, matching the existing Aigate deployment.
[Unit]
Description=Raazi QA application and PostgreSQL containers
Wants=network-online.target
After=network-online.target
RequiresMountsFor=/opt/rnd/raazi

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/rnd/raazi
ExecStart=/usr/bin/bash /opt/rnd/raazi/raazictl start
ExecStop=/usr/bin/bash /opt/rnd/raazi/raazictl stop
TimeoutStartSec=300
TimeoutStopSec=180

[Install]
WantedBy=multi-user.target

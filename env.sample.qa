# Copy to .env.qa on the QA host. Never commit the filled file.
# QA uses real Portal authentication and secure cookies, not development login.
# Keep QA credentials and databases separate from production.
COMPOSE_PROJECT_NAME=raazi-qa
AUTH_MODE=portal
PORTAL_API_URL=https://portal.sngpl.com.pk/portalAppsApi
# Explicit, comma-separated Portal administrator usernames.
PORTAL_ADMIN_USERS=
# Stable signing secret: at least 32 characters.
SECRET_KEY=
# Independent, base64/base64url-encoded 32-byte encryption key.
ENCRYPTION_KEY=
POSTGRES_PASSWORD=
# Use the same password as POSTGRES_PASSWORD. URL-encode special characters.
PRODUCTION_DATABASE_URL=postgresql://raazi:<URL-encoded-password>@vectors:5432/raazi_vectors
RAAZI_IMAGE_TAG=local
CONTAINER_LOG_DRIVER=k8s-file
INFERENCE_NETWORK=podnet10
# Optional OIDC alternative: set AUTH_MODE=oidc and supply these values.
OIDC_DISCOVERY_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=
ADMIN_GROUP=

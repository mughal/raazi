# Copy to .env.production on the production host. Keep it outside Git.
# Preserve existing signing and encryption keys when you migrate an installation.
AUTH_MODE=oidc
# For Aigate-style Portal password + authenticator sign-in, use AUTH_MODE=portal.
PORTAL_API_URL=https://portal.sngpl.com.pk/portalAppsApi
# Explicit, comma-separated Portal usernames. Other users receive the user role.
PORTAL_ADMIN_USERS=
SECRET_KEY=
ENCRYPTION_KEY=
OIDC_DISCOVERY_URL=https://your-provider/.well-known/openid-configuration
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=https://raazi.example.com/auth/callback
ADMIN_GROUP=
POSTGRES_PASSWORD=
# Use the Compose service name vectors, not localhost.
# Use the same password as POSTGRES_PASSWORD. URL-encode special characters.
PRODUCTION_DATABASE_URL=postgresql://raazi:<URL-encoded-password>@vectors:5432/raazi_vectors
# Use the release commit as the local image tag.
RAAZI_IMAGE_TAG=local
# For the Podman overlay, set CONTAINER_LOG_DRIVER=k8s-file.
# CONTAINER_LOG_DRIVER=k8s-file
# INFERENCE_NETWORK=podnet10

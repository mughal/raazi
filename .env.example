# Copy to ignored .env or set these in the service environment.
# Never commit real secrets. Generate a separate random value for each key.
SECRET_KEY=
AUTH_MODE=oidc
OIDC_DISCOVERY_URL=https://your-provider/.well-known/openid-configuration
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=https://raazi.example.com/auth/callback
ADMIN_GROUP=raazi-admins
COOKIE_SECURE=true
# Base64-encoded 32-byte key. Preserve your existing key during upgrades.
ENCRYPTION_KEY=
HOST=127.0.0.1
PORT=8080
DATABASE=data/raazi.db
# Optional semantic index service. Without it, Node uses local exact cosine search.
# VECTOR_DATABASE_URL=postgresql://raazi:<URL-encoded-password>@127.0.0.1:5432/raazi_vectors
# Used by Docker Compose. Keep the real value outside Git.
# POSTGRES_PASSWORD=
# Chat history defaults to VECTOR_DATABASE_URL in the same PostgreSQL container.
# Set CHAT_DATABASE_URL only to override it. An explicitly empty value forces local history.

# Reference only: set these in the process environment.
SECRET_KEY=replace-with-a-long-random-secret
AUTH_MODE=oidc
OIDC_DISCOVERY_URL=https://your-provider/.well-known/openid-configuration
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=https://raazi.example.com/auth/callback
ADMIN_GROUP=raazi-admins
COOKIE_SECURE=true
ENCRYPTION_KEY=

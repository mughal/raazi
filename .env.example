# Reference only: set these in the process environment.
SECRET_KEY=replace-with-a-long-random-secret
AUTH_MODE=oidc
OIDC_DISCOVERY_URL=https://your-provider/.well-known/openid-configuration
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=https://raazi.example.com/auth/callback
ADMIN_GROUP=raazi-admins
COOKIE_SECURE=true
ENCRYPTION_KEY=
# Optional semantic index service. If omitted, SQLite uses exact cosine search.
# VECTOR_DATABASE_URL=postgresql://raazi:<URL-encoded-password>@127.0.0.1:5432/raazi_vectors
# Used by docker compose, never checked into Git with a real value.
# POSTGRES_PASSWORD=
